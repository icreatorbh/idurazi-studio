{
  "manifestVersion": 5,
  "id": "com.idurazi.premiere-ai-assistant",
  "name": "iDurazi Premiere Copilot — Local Transcription",
  "version": "2.5.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "com.idurazi.premiere-ai-assistant.panel",
      "label": {
        "default": "iDurazi Premiere Copilot"
      },
      "minimumSize": {
        "width": 340,
        "height": 520
      },
      "maximumSize": {
        "width": 1000,
        "height": 1400
      },
      "preferredDockedSize": {
        "width": 430,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 800
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-normal.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "light",
            "lightest"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:37841",
        "http://localhost:37841",
        "https://api.openai.com"
      ]
    },
    "localFileSystem": "request"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-app.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "light",
        "lightest"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}